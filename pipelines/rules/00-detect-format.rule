rule "UniFi - detect mixed format"
when
  has_field("unifi_ingest") && to_bool($message.unifi_ingest)
then
  set_field("unifi_schema_version", "gim-7.1");
  set_field("unifi_integration_version", "0.1.0");
  set_field("full_message", to_string($message.message));
  let cef = regex(pattern: "(?:^|\\s)(CEF:\\d+\\|Ubiquiti\\|UniFi Network\\|.*)$", value: to_string($message.message));
  let device = regex(pattern: "^[^ ]+ [0-9A-Fa-f]{12},.+-\\d+\\.\\d+\\.\\d+\\+\\d+:", value: to_string($message.message));
  set_field("unifi_log_format", if(cef.matches, "cef", if(device.matches, "syslog", "unknown")));
  set_field("unifi_parse_status", if(cef.matches || device.matches, "detected", "malformed"));
end
